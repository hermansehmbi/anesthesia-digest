__pycache__/
*.pyc
preview_*.html
podcast.mp3
podcast_script.txt
*.mp3
*_script.txt
# monday_featured.json and weekly_summaries.json are intentionally TRACKED (the
# Monday -> Saturday hand-off survives a wiped Actions cache). The rest stay out.
articles_cache.json
fulltext_cache.json
summaries_cache.json
moc_tracker.xlsx
self_assessment_tracker.xlsx
.env

# Google service-account keys — NEVER commit (use the GitHub Secret instead).
service_account*.json
*service-account*.json
gcp-*.json
credentials.json

# Published podcast episodes ARE tracked so GitHub Pages can serve them.
!docs/audio/*.mp3

# Intro/outro music MUST be committed so GitHub Actions can mix them in.
!assets/*.mp3

# macOS
.DS_Store
